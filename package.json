{
  "name": "jobyssey",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @jobyssey/db db:generate",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint:root": "eslint --max-warnings 0 --no-error-on-unmatched-pattern scripts tests tooling eslint.config.js vitest.config.ts",
    "test:root": "vitest run --config vitest.config.ts",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages tooling",
    "check:workspace": "node scripts/check-workspace.ts",
    "check:migrations": "node scripts/check-migrations.ts",
    "lint:files": "ls-lint",
    "lint:deps": "sherif",
    "lint:unused": "knip",
    "ui:add": "node scripts/shadcn-add.ts",
    "gen:feature": "node scripts/gen-feature.ts",
    "start": "pnpm --filter @jobyssey/web build && node apps/api/src/main.ts",
    "dev": "turbo run dev",
    "smoke": "node scripts/smoke.ts",
    "check": "pnpm check:workspace && pnpm lint:files && pnpm lint:deps && turbo run typecheck lint test && pnpm typecheck:root && pnpm lint:root && pnpm lint:boundaries && pnpm check:migrations && pnpm lint:unused && pnpm test:root"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@jobyssey/db": "workspace:*",
    "@jobyssey/eslint-config": "workspace:*",
    "@jobyssey/typescript-config": "workspace:*",
    "@ls-lint/ls-lint": "catalog:",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "drizzle-orm": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "knip": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "sherif": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  },
  "sherif": {
    "failOnWarnings": true
  }
}
