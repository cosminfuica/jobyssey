{
  "name": "jobyssey",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "FSL-1.1-ALv2",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck:root": "tsc -p tsconfig.json",
    "lint:root": "eslint --max-warnings 0 --no-error-on-unmatched-pattern scripts tests tooling eslint.config.js vitest.config.ts",
    "test:root": "vitest run --config vitest.config.ts",
    "lint:boundaries": "depcruise --config .dependency-cruiser.cjs apps packages tooling"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@commitlint/types": "catalog:",
    "@jobyssey/eslint-config": "workspace:*",
    "@jobyssey/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "prettier": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "catalog:"
  }
}
