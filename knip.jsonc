{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // Todo 16 flips this to true once every public consumer exists.
  "includeEntryExports": false,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "commitlint*.config.ts",
        "eslint.config.js",
        "vitest.config.ts",
      ],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"],
    },
    "packages/*": {
      "entry": ["{index,server,schema,shared}.ts", "client.tsx"],
      "project": ["**/*.{ts,tsx}"],
    },
    "packages/api-shell": {
      "ignoreDependencies": ["pino-pretty"],
    },
    "packages/ui": {
      "entry": ["src/components/*.tsx", "src/hooks/*.ts", "src/lib/*.ts"],
      // imported from globals.css only, which knip does not read
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "shadcn",
        "@fontsource-variable/geist",
      ],
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/dev.ts"],
    },
    "apps/web": {
      "entry": ["src/main.tsx", "vite.config.ts"],
      // imported only as CSS
      "ignoreDependencies": ["@jobyssey/ui"],
    },
    "tooling/*": {
      "entry": ["index.{js,ts}"],
    },
  },
  "ignore": ["**/tests/fixtures/**", "tests/boundaries/fixtures/**"],
  "rules": {
    // The catalog already holds the versions for packages added by later todos (db, api-shell, ui, apps); knip lists them on every run. Set back to "error" once every entry is referenced.
    "catalog": "warn",
  },
}
