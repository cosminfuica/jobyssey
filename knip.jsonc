{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"],
    },
    "packages/*": {
      "entry": ["{index,server,schema,shared}.ts", "client.tsx"],
      "project": ["**/*.{ts,tsx}"],
    },
    "packages/api-shell": {
      // pino loads it by name (transport target "pino-pretty" in lib/logger.ts), which knip cannot see
      "ignoreDependencies": ["pino-pretty"],
    },
    "packages/registry": {
      // every package holding .tsx declares @types/react; the registry itself has no JSX
      "ignoreDependencies": ["@types/react"],
    },
    "packages/ui": {
      // shadcn components are a kit: pnpm ui:add regenerates every export, used or not
      "includeEntryExports": false,
      "entry": ["src/components/*.tsx", "src/hooks/*.ts", "src/lib/*.ts"],
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/dev.ts"],
    },
    "apps/web": {
      "entry": ["src/main.tsx"],
    },
    "tooling/*": {
      "entry": ["index.{js,ts}"],
    },
  },
  // dependency-cruiser fixtures: deliberate rule violations that tests/boundaries feeds to depcruise as data; nothing imports them
  "ignore": ["tests/boundaries/fixtures/**"],
}
