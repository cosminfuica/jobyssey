{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "includeEntryExports": true,
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts"],
      "project": ["scripts/**/*.ts", "tests/**/*.ts"],
    },
    "packages/*": {
      "entry": ["{index,server,schema,shared}.ts", "client.tsx"],
      "project": ["**/*.{ts,tsx}"],
    },
    "packages/api-shell": {
      "ignoreDependencies": ["pino-pretty"],
    },
    "packages/registry": {
      // every package holding .tsx declares @types/react; the registry itself has no JSX
      "ignoreDependencies": ["@types/react"],
    },
    "packages/ui": {
      // shadcn components are a kit: pnpm ui:add regenerates every export, used or not
      "includeEntryExports": false,
      "entry": ["src/components/*.tsx", "src/hooks/*.ts", "src/lib/*.ts"],
      // imported from globals.css only, which knip does not read
      "ignoreDependencies": [
        "tailwindcss",
        "tw-animate-css",
        "shadcn",
        "@fontsource-variable/geist",
      ],
    },
    "apps/api": {
      "entry": ["src/main.ts", "src/dev.ts"],
    },
    "apps/web": {
      "entry": ["src/main.tsx"],
      // imported only as CSS
      "ignoreDependencies": ["@jobyssey/ui"],
    },
    "tooling/*": {
      "entry": ["index.{js,ts}"],
    },
  },
  "ignore": ["**/tests/fixtures/**", "tests/boundaries/fixtures/**"],
}
