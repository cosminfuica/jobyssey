{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:best-practices", "schedule:weekly", "group:allNonMajor"],
  // Renovate updates the `catalog` in pnpm-workspace.yaml natively, which is
  // why the catalog stays in that file.
  rangeStrategy: "bump",
  postUpdateOptions: ["pnpmDedupe"],
  // Matches pnpm 12's default minimumReleaseAge of 1440 minutes.
  minimumReleaseAge: "1 day",
  packageRules: [
    {
      // typescript-eslint's peer range.
      matchPackageNames: ["typescript"],
      allowedVersions: "<6.1",
    },
    {
      matchPackageNames: ["drizzle-orm", "drizzle-kit", "@electric-sql/pglite"],
      rangeStrategy: "pin",
    },
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
    },
  ],
  ignoreDeps: ["node"],
}
